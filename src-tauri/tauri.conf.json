{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memTools",
  "version": "0.8.1",
  "identifier": "com.memtools.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "memTools",
        "width": 480,
        "height": 560,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true,
        "create": false
      },
      {
        "label": "selector",
        "url": "selection.html",
        "title": "memTools 划词",
        "width": 40,
        "height": 40,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "create": false
      },
      {
        "label": "ai",
        "url": "ai.html",
        "title": "memTools · AI 与知识库",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi"
      }
    }
  }
}
